# ==============================================================================
# EPICRIO AUTONOMOUS LEAD & OUTREACH ENGINE CONFIGURATION
# ==============================================================================

# 1. Telegram Bot Integration (Instant Alerts & 2-Way Commands)
# Create a bot via @BotFather on Telegram to get your bot token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your personal numeric Telegram Chat ID via @userinfobot on Telegram:
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. Resend Email Engine (Outreach & Confirmation Inbounds)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Epicrio <onboarding@resend.dev>

# 3. Optional: Discord Inbound Webhook (Parallel notifications)
DISCORD_WEBHOOK_URL=
